{
  "description": "Block Claude from stopping while the project's goal checklist has open items",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/goal-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
